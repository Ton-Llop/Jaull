/* Sober palette for the jaull TUI.

   Design tokens
   -------------
   Text hierarchy — three levels, used consistently:
     primary    #e5e7eb   titles, model names, answers, response bodies
     secondary  #b3bac6   subtitles, metadata lines, footer
     muted      #8b95a5   timings, hints, pending steps, CLI labels

   Colour carries one meaning each:
     #3a7bd5 blue   action / current step / focus
     #10b981 green  success / comfortable
     #f59e0b amber  warning / tight
     #ef4444 red    failure

   Surface hierarchy — reach for the lightest one that works:
     .surface-strong  bordered + tinted. Primary recommendation, modals,
                      focused inputs. Nothing else.
     .surface-subtle  tinted, at most one edge rule. Model responses,
                      key/value blocks.
     .section         plain: a title and whitespace. The default.
     .rule            one hairline, for separating zones (header, composer).

   .card / .banner keep the older boxed look and stay in the advanced tools,
   which are deliberately a denser, expert-facing mode.
   --------------------------------------------------------------------- */

Screen {
    background: #0e1116;
    color: #e5e7eb;
}

/* ---------------------------------------------------------------------
   Layout baseline.

   Textual's Vertical, Horizontal and ListView all default to `height: 1fr`.
   Every container in this app is a block of document flow inside a scroll
   region, never a flexible pane, so that default makes a single block expand
   to the whole viewport and pushes everything after it below the fold. Size
   them to their content instead; the surrounding VerticalScroll is what
   flexes.
   --------------------------------------------------------------------- */
VerticalScroll > Vertical,
VerticalScroll > Horizontal,
Vertical > Vertical,
Vertical > Horizontal,
ListView {
    height: auto;
}

Header {
    background: #111827;
    color: #e5e7eb;
    text-style: bold;
    height: 1;
    border-bottom: solid #1f2937;
}

/* The default header icon is U+2B58, which most terminal fonts lack and which
   renders as a replacement box. Nothing here depends on it. */
HeaderIcon {
    display: none;
}

Footer {
    background: #111827;
    color: #b3bac6;
}

Footer > .footer--key {
    color: #3a7bd5;
    text-style: bold;
}

/* ---------------------------------------------------------------------
   Text hierarchy.
   --------------------------------------------------------------------- */
.text-primary   { color: #e5e7eb; }
.text-secondary { color: #b3bac6; }

/* Secondary information, not decoration: readable, but clearly below the
   primary level. */
.text-muted {
    color: #8b95a5;
    padding: 0 0 1 0;
}

.section {
    height: auto;
    margin: 0 0 1 0;
}

.section-title {
    color: #e5e7eb;
    text-style: bold;
    padding: 0 0 1 0;
}

/* An eyebrow above a block: small, blue, uppercase at the call site. */
.kicker {
    color: #3a7bd5;
    text-style: bold;
}

.rule {
    border-bottom: solid #1f2937;
}

.surface-strong {
    background: #131922;
    border: round #3a7bd5;
    padding: 0 2;
    margin: 0 0 1 0;
    height: auto;
}

.surface-subtle {
    background: #121821;
    padding: 0 1;
    height: auto;
}

/* ---------------------------------------------------------------------
   Boxed surfaces, kept for the advanced tools and the detail drill-downs.
   --------------------------------------------------------------------- */
.banner {
    background: #111827;
    color: #e5e7eb;
    padding: 0 2;
    border: round #1f2937;
    margin: 0 0 1 0;
    height: auto;
}

.banner-title {
    text-style: bold;
    color: #3a7bd5;
}

.banner-subtitle {
    color: #b3bac6;
}

.card {
    background: #131922;
    border: round #1f2937;
    padding: 0 2;
    margin: 0 0 1 0;
    height: auto;
}

.card-title {
    text-style: bold;
    color: #3a7bd5;
    padding: 0 0 1 0;
}

.menu {
    background: #131922;
    border: round #1f2937;
    padding: 0 2;
    margin: 0 0 1 0;
    height: auto;
}

.menu > .menu-item {
    padding: 0 1;
    color: #e5e7eb;
}

.menu > .menu-item:hover,
.menu > .menu-item.-current {
    background: #1f2937;
    text-style: bold;
}

.status-ok    { color: #10b981; text-style: bold; }
.status-warn  { color: #f59e0b; text-style: bold; }
.status-fail  { color: #ef4444; text-style: bold; }

Input {
    background: #131922;
    border: round #1f2937;
    color: #e5e7eb;
}
Input:focus {
    border: round #3a7bd5;
}

TextArea {
    background: #0b0f16;
    border: round #1f2937;
    color: #e5e7eb;
    height: 5;
}

TextArea:focus {
    border: round #3a7bd5;
}

Button {
    background: #1f2937;
    color: #e5e7eb;
    border: none;
    padding: 0 3;
    height: 3;
}
Button.-primary {
    background: #3a7bd5;
    color: #ffffff;
    text-style: bold;
}
Button:focus, Button:hover {
    background: #2b3748;
}
Button.-primary:focus, Button.-primary:hover {
    background: #4a8be5;
}

/* One-line button for dense rows. Textual's Button ships `min-width: 16`,
   which is what makes a "Run" button as wide as a sentence. */
Button.-compact {
    height: 1;
    min-width: 6;
    padding: 0 2;
}

/* Tertiary action: present, never competing. */
Button.-quiet {
    height: 1;
    min-width: 0;
    padding: 0 2;
    background: transparent;
    color: #8b95a5;
}
Button.-quiet:focus, Button.-quiet:hover {
    background: transparent;
    color: #b3bac6;
    text-style: underline;
}

DataTable {
    background: #131922;
    color: #e5e7eb;
}
DataTable > .datatable--header {
    background: #1f2937;
    color: #b3bac6;
    text-style: bold;
}

.warnings {
    background: #1a1207;
    border: round #f59e0b;
    color: #fbbf24;
    padding: 0 2;
    margin: 0 0 1 0;
    height: auto;
}

/* Inside a warnings panel the heading is part of the warning, not a blue
   section title. */
.warnings .card-title {
    color: #f59e0b;
}

.cli-hint {
    background: #131922;
    border: round #1f2937;
    color: #b3bac6;
    padding: 0 2;
    margin: 0 0 1 0;
    height: auto;
}

.cli-hint-label {
    color: #8b95a5;
    text-style: italic;
}

/* Badges size to their label; without this the background stripe runs the
   full width of the card. */
.badge {
    width: auto;
    padding: 0 2;
    margin: 0 0 1 0;
    text-style: bold;
}
.badge-comfortable        { color: #10b981; background: #052e21; }
.badge-compatible         { color: #10b981; background: #052e21; }
.badge-tight              { color: #f59e0b; background: #2a1e05; }
.badge-offloading         { color: #f59e0b; background: #2a1e05; }
.badge-insufficient       { color: #ef4444; background: #2a0808; }
.badge-unknown            { color: #b3bac6; background: #1f2937; }

.usage-bar {
    height: 1;
    background: #1f2937;
    color: #3a7bd5;
    margin: 0 0 1 0;
}

.logo {
    background: #060d14;
    padding: 1 2 0 2;
    margin: 0 0 1 0;
    height: auto;
    align: center top;
}
.logo-ascii {
    color: #7fb8c3;
    text-style: bold;
    content-align: center middle;
    width: auto;
    height: auto;
    margin-bottom: 0;
}

.logo-subtitle {
    color: #5b7d86;
    text-style: bold;
    content-align: center middle;
    width: auto;
    height: auto;
    margin-top: 0;
}

.runtime-card {
    background: #131922;
    border: round #3a7bd5;
    padding: 0 2;
    margin: 0 0 1 0;
    height: auto;
}
.runtime-title {
    color: #3a7bd5;
    text-style: bold;
}
.runtime-code {
    background: #0b0f16;
    color: #e5e7eb;
    padding: 0 2;
    margin: 0 0 1 0;
    border: round #1f2937;
}

/* ---------------------------------------------------------------------
   Welcome.
   --------------------------------------------------------------------- */
#welcome-body {
    padding: 0 2;
}

#welcome-tagline {
    color: #b3bac6;
    padding: 0 0 1 0;
}

#welcome-menu {
    background: transparent;
    height: auto;
}

#welcome-menu > ListItem {
    background: transparent;
    padding: 0 0 1 1;
}

#welcome-menu > ListItem.-highlight {
    background: #1b2432;
}

.menu-label {
    color: #e5e7eb;
    text-style: bold;
}

#welcome-menu > ListItem.-highlight .menu-label {
    color: #3a7bd5;
}

.menu-hint {
    color: #8b95a5;
}

/* ---------------------------------------------------------------------
   Guided workflow header: a heading, not a panel.
   --------------------------------------------------------------------- */
.workflow-header {
    height: auto;
    padding: 0 2;
    margin: 0 0 1 0;
    border-bottom: solid #1f2937;
}

.workflow-title {
    color: #e5e7eb;
    text-style: bold;
    width: 1fr;
}

.workflow-step-count {
    color: #8b95a5;
    width: auto;
    text-align: right;
}

.workflow-subtitle {
    color: #b3bac6;
    padding: 0 0 1 0;
}

.workflow-breadcrumb {
    color: #b3bac6;
}

.step-done    { color: #10b981; }
.step-running { color: #3a7bd5; text-style: bold; }
.step-pending { color: #8b95a5; }
.step-failed  { color: #ef4444; text-style: bold; }

/* A row whose single action sits on the right edge. */
.actions-right {
    height: auto;
    align-horizontal: right;
    margin: 0 0 1 0;
}

/* ---------------------------------------------------------------------
   Hardware.
   --------------------------------------------------------------------- */
#hardware-content,
#hardware-summary {
    height: auto;
    padding: 0 2;
}

/* ---------------------------------------------------------------------
   Requirements wizard: questions separated by whitespace, not by boxes.
   --------------------------------------------------------------------- */
#wizard-body {
    padding: 0 2;
}

.question {
    height: auto;
    margin: 0 0 1 0;
}

.question-title {
    color: #e5e7eb;
    text-style: bold;
}

.question-note {
    color: #8b95a5;
    padding: 0 0 0 3;
}

.question > RadioSet,
.question > Checkbox,
.question > Input {
    background: transparent;
    margin: 0 0 0 3;
}

.question > Input {
    width: 60;
}

#wizard-errors {
    height: auto;
}

RadioSet {
    background: transparent;
    border: none;
    height: auto;
}

Checkbox {
    background: transparent;
    border: none;
}

/* ---------------------------------------------------------------------
   Results.
   --------------------------------------------------------------------- */
#results-body,
#compare-body,
#details-body {
    padding: 0 2;
}

.results-primary {
    background: #131922;
    border: round #3a7bd5;
    padding: 0 2;
    margin: 0 0 1 0;
    height: auto;
}

.results-kicker,
.results-section-title {
    color: #3a7bd5;
    text-style: bold;
}

.results-section-title {
    padding: 1 0 0 0;
}

.results-model-name {
    color: #e5e7eb;
    text-style: bold;
}

.results-score-line {
    color: #10b981;
    width: 1fr;
}

.results-fit {
    width: auto;
    text-align: right;
}

.fit-good    { color: #10b981; }
.fit-warn    { color: #f59e0b; }
.fit-bad     { color: #ef4444; }
.fit-unknown { color: #8b95a5; }

.results-meta-line {
    color: #8b95a5;
    padding: 0 0 1 0;
}

.results-alternative {
    height: auto;
    padding: 0 1;
    margin: 0 0 1 0;
    background: #121821;
}

.results-alt-rank {
    width: 4;
    color: #8b95a5;
}

.results-alt-name {
    width: 1fr;
    color: #e5e7eb;
}

.results-alt-score {
    width: 8;
    color: #b3bac6;
}

.results-alt-fit {
    width: 16;
}

.reason-line {
    color: #10b981;
    padding: 0 0 0 1;
}

.warning-line {
    color: #f59e0b;
    padding: 0 0 0 1;
}

.score-row {
    color: #b3bac6;
}

#results-actions,
#results-actions-secondary,
#discovery-actions,
#wizard-actions {
    height: auto;
}

/* The panel closes on its action; a margin under it only adds dead rows. */
.results-primary .actions-right {
    margin: 0;
}

#results-actions Button,
#results-actions-secondary Button,
#discovery-actions Button {
    margin: 0 1 0 0;
}

#discovery-messages,
#discovery-body {
    height: auto;
}

#discovery-body {
    padding: 0 2;
}

/* A modal should read as something on top of the results, not as a new page. */
ExportReportModal {
    align: center middle;
}

#export-modal {
    background: #131922;
    border: round #3a7bd5;
    padding: 1 2;
    width: 80;
    max-width: 100%;
    height: auto;
}

#res-export-actions {
    height: auto;
}

#res-export-actions Button {
    margin: 0 1 0 0;
}

/* --------------------------------------------------------------------
   Tier headings + compact score strip.
   -------------------------------------------------------------------- */
.tier-best-match     { color: #10b981; }
.tier-recommended    { color: #3a7bd5; }
.tier-closest-option { color: #f59e0b; }
.tier-best-effort    { color: #b3bac6; }

.compact-score-strip {
    background: #131922;
    border: round #1f2937;
    padding: 0 1;
    margin: 0 0 1 0;
    height: auto;
}
.score-total    { color: #e5e7eb; }
.score-penalty  { color: #f59e0b; }

/* ---------------------------------------------------------------------
   Run screen: header, history, composer. History is the dominant zone.
   --------------------------------------------------------------------- */
.run-header {
    padding: 0 2;
    height: auto;
    margin: 0 0 1 0;
    border-bottom: solid #1f2937;
}

.run-title {
    color: #e5e7eb;
    text-style: bold;
}

.run-meta {
    color: #b3bac6;
}

#run-history {
    height: 1fr;
    padding: 0 2;
}

#run-console {
    height: auto;
    border-top: solid #1f2937;
    padding: 0 2;
}

.run-status {
    color: #b3bac6;
    height: 1;
}

.run-error-message {
    color: #fbbf24;
    border-left: solid #f59e0b;
    padding: 0 0 0 1;
    height: auto;
}

#run-composer {
    height: auto;
    padding: 0 0 1 0;
}

#run-composer TextArea {
    width: 1fr;
    height: 4;
}

#run-composer Button {
    width: auto;
    margin: 0 0 0 1;
}

.inference-entry {
    height: auto;
    margin: 0 0 1 0;
}

.inference-prompt {
    border-left: solid #2b3748;
    padding: 0 0 0 1;
}

.inference-response {
    background: #121821;
    border-left: solid #3a7bd5;
    padding: 0 0 0 1;
}

.message-label {
    color: #8b95a5;
    text-style: bold;
}

.inference-response .message-label {
    color: #3a7bd5;
}

.message-text {
    color: #e5e7eb;
}

.message-meta {
    color: #8b95a5;
}
