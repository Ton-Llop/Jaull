/* Corporate palette for jaull TUI.
   Sober, professional; no bright green or terminal-hacker aesthetics. */

Screen {
    background: #0e1116;
    color: #e5e7eb;
}

/* ---------------------------------------------------------------------
   Layout baseline.

   Textual's Vertical, Horizontal and ListView all default to `height: 1fr`.
   Every container in this app is a block of document flow inside a scroll
   region, never a flexible pane, so that default makes a single block expand
   to the whole viewport and pushes everything after it below the fold. Size
   them to their content instead; the surrounding VerticalScroll is what
   flexes.
   --------------------------------------------------------------------- */
VerticalScroll > Vertical,
VerticalScroll > Horizontal,
Vertical > Vertical,
Vertical > Horizontal,
ListView {
    height: auto;
}

Header {
    background: #111827;
    color: #e5e7eb;
    text-style: bold;
    height: 1;
    border-bottom: solid #1f2937;
}

/* The default header icon is U+2B58, which most terminal fonts lack and which
   renders as a replacement box. Nothing here depends on it. */
HeaderIcon {
    display: none;
}

Footer {
    background: #111827;
    color: #9ca3af;
}

Footer > .footer--key {
    color: #3a7bd5;
    text-style: bold;
}

.banner {
    background: #111827;
    color: #e5e7eb;
    padding: 0 2;
    border: round #1f2937;
    margin: 0 0 1 0;
    height: auto;
}

.banner-title {
    text-style: bold;
    color: #3a7bd5;
}

.banner-subtitle {
    color: #9ca3af;
}

.card {
    background: #131922;
    border: round #1f2937;
    padding: 0 2;
    margin: 0 0 1 0;
    height: auto;
}

.card-title {
    text-style: bold;
    color: #3a7bd5;
    padding: 0 0 1 0;
}

.menu {
    background: #131922;
    border: round #1f2937;
    padding: 0 2;
    margin: 0 0 1 0;
    height: auto;
}

.menu > .menu-item {
    padding: 0 1;
    color: #e5e7eb;
}

.menu > .menu-item:hover,
.menu > .menu-item.-current {
    background: #1f2937;
    text-style: bold;
}

.status-ok    { color: #10b981; text-style: bold; }
.status-warn  { color: #f59e0b; text-style: bold; }
.status-fail  { color: #ef4444; text-style: bold; }

Input {
    background: #131922;
    border: round #1f2937;
    color: #e5e7eb;
}
Input:focus {
    border: round #3a7bd5;
}

TextArea {
    background: #0b0f16;
    border: round #1f2937;
    color: #e5e7eb;
    height: 5;
}

TextArea:focus {
    border: round #3a7bd5;
}

Button {
    background: #1f2937;
    color: #e5e7eb;
    border: none;
    padding: 0 3;
    height: 3;
}
Button.-primary {
    background: #3a7bd5;
    color: #ffffff;
    text-style: bold;
}
Button:focus, Button:hover {
    background: #2b3748;
}

DataTable {
    background: #131922;
    color: #e5e7eb;
}
DataTable > .datatable--header {
    background: #1f2937;
    color: #9ca3af;
    text-style: bold;
}

.warnings {
    background: #1a1207;
    border: round #f59e0b;
    color: #fbbf24;
    padding: 0 2;
    margin: 0 0 1 0;
    height: auto;
}

/* Inside a warnings panel the heading is part of the warning, not a blue
   section title. */
.warnings .card-title {
    color: #f59e0b;
}

.cli-hint {
    background: #131922;
    border: round #1f2937;
    color: #9ca3af;
    padding: 0 2;
    margin: 0 0 1 0;
    height: auto;
}

.cli-hint-label {
    color: #6b7280;
    text-style: italic;
}

/* Badges size to their label; without this the background stripe runs the
   full width of the card. */
.badge {
    width: auto;
    padding: 0 2;
    margin: 0 0 1 0;
    text-style: bold;
}
.badge-comfortable        { color: #10b981; background: #052e21; }
.badge-compatible         { color: #10b981; background: #052e21; }
.badge-tight              { color: #f59e0b; background: #2a1e05; }
.badge-offloading         { color: #f59e0b; background: #2a1e05; }
.badge-insufficient       { color: #ef4444; background: #2a0808; }
.badge-unknown            { color: #9ca3af; background: #1f2937; }

.usage-bar {
    height: 1;
    background: #1f2937;
    color: #3a7bd5;
    margin: 0 0 1 0;
}

.logo {
    background: #060d14;
    padding: 1 2 0 2;
    margin: 0 0 1 0;
    height: auto;
    align: center top;
}
.logo-ascii {
    color: #7fb8c3;
    text-style: bold;
    content-align: center middle;
    width: auto;
    height: auto;
    margin-bottom: 0;
}

.logo-subtitle {
    color: #5b7d86;
    text-style: bold;
    content-align: center middle;
    width: auto;
    height: auto;
    margin-top: 0;
}

.text-muted {
    color: #6b7280;
    padding: 0 0 1 0;
}

.runtime-card {
    background: #131922;
    border: round #3a7bd5;
    padding: 0 2;
    margin: 0 0 1 0;
    height: auto;
}
.runtime-title {
    color: #3a7bd5;
    text-style: bold;
}
.runtime-code {
    background: #0b0f16;
    color: #e5e7eb;
    padding: 0 2;
    margin: 0 0 1 0;
    border: round #1f2937;
}

/* ---------------------------------------------------------------------
   Run screen.
   --------------------------------------------------------------------- */
.run-header {
    background: #111827;
    border-bottom: solid #1f2937;
    padding: 0 2;
    height: auto;
}

.run-title {
    color: #e5e7eb;
    text-style: bold;
}

.run-meta {
    color: #9ca3af;
}

#run-history {
    height: 1fr;
    padding: 0 2 1 2;
}

#run-console {
    height: auto;
    background: #111827;
    border-top: solid #1f2937;
    padding: 0 2;
}

.run-status {
    color: #9ca3af;
    padding: 0 0 1 0;
    height: auto;
}

.run-error-message {
    color: #fbbf24;
    background: #1a1207;
    padding: 0 1;
    margin: 0 0 1 0;
    height: auto;
}

#run-composer {
    height: auto;
}

#run-composer TextArea {
    width: 1fr;
}

#run-composer Button {
    width: auto;
    margin: 0 0 0 1;
}

.inference-entry {
    height: auto;
    margin: 0 0 1 0;
    padding: 0 1;
}

.inference-prompt {
    border-left: solid #2b3748;
}

.inference-response {
    background: #0b0f16;
    border: solid #1f2937;
}

.message-label {
    color: #3a7bd5;
    text-style: bold;
}

.message-text {
    color: #e5e7eb;
}

.message-meta {
    color: #6b7280;
}

/* ---------------------------------------------------------------------
   Guided recommendation workflow.
   Same sober palette as the rest of the app: no new accent colours, no
   animation, and status is carried by a marker glyph as well as by colour.
   --------------------------------------------------------------------- */
.workflow-header {
    background: #111827;
    padding: 0 2;
    border: round #1f2937;
    margin: 0 0 1 0;
    height: auto;
}

.workflow-breadcrumb {
    color: #9ca3af;
}

.step-done    { color: #10b981; }
.step-running { color: #3a7bd5; text-style: bold; }
.step-pending { color: #6b7280; }
.step-failed  { color: #ef4444; text-style: bold; }

.recommendation-card {
    background: #131922;
    border: round #3a7bd5;
    padding: 0 2;
    margin: 0 0 1 0;
    height: auto;
}

.reason-line {
    color: #10b981;
    padding: 0 0 0 1;
}

.warning-line {
    color: #f59e0b;
    padding: 0 0 0 1;
}

.score-row {
    color: #9ca3af;
}

#results-actions,
#discovery-actions {
    height: auto;
    padding: 0 0 1 0;
}

#results-actions Button,
#discovery-actions Button {
    margin: 0 1 0 0;
}

#wizard-errors,
#discovery-messages,
#hardware-summary,
#hardware-content {
    height: auto;
}

.results-primary {
    background: #131922;
    border: round #3a7bd5;
    padding: 0 2 1 2;
    margin: 0 0 1 0;
    height: auto;
}

.results-kicker,
.results-section-title {
    color: #3a7bd5;
    text-style: bold;
}

.results-model-name {
    color: #e5e7eb;
    text-style: bold;
}

.results-score-line {
    color: #10b981;
}

.results-meta-line {
    color: #9ca3af;
}

.results-alternative {
    background: #131922;
    border: solid #1f2937;
    padding: 0 2 1 2;
    margin: 0 0 1 0;
    height: auto;
}

.results-alt-title {
    color: #e5e7eb;
    text-style: bold;
}

#export-modal {
    background: #131922;
    border: round #3a7bd5;
    padding: 1 2;
    width: 80;
    height: auto;
}

#res-export-actions {
    height: auto;
}

#res-export-actions Button {
    margin: 0 1 0 0;
}

RadioSet {
    background: #131922;
    border: none;
    height: auto;
}

Checkbox {
    background: #131922;
    border: none;
}

/* --------------------------------------------------------------------
   Fase 5: tier headings + compact score strip.
   -------------------------------------------------------------------- */
.tier-best-match     { color: #10b981; }
.tier-recommended    { color: #3a7bd5; }
.tier-closest-option { color: #f59e0b; }
.tier-best-effort    { color: #9ca3af; }

.compact-score-strip {
    background: #131922;
    border: round #1f2937;
    padding: 0 1;
    margin: 0 0 1 0;
    height: auto;
}
.score-total    { color: #e5e7eb; }
.score-penalty  { color: #f59e0b; }
